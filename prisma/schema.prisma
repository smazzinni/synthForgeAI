generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  agentInstructions String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  projects         Project[]
  conversations    Conversation[]
  apiKeys          ApiKey[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  databases   Database[]
}

model Database {
  id          String   @id @default(cuid())
  name        String
  dbType      String   @default("postgresql")
  schemaJson  String   @default("{}")
  dataJson    String   @default("{}")
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  datasets    Dataset[]
  schemaVersions SchemaVersion[]
}

model Conversation {
  id          String   @id @default(cuid())
  title       String   @default("New Conversation")
  databaseId  String
  workspaceId String
  agentMode   String   @default("plan") // plan | execute | auto
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  database    Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]
  agentSteps  AgentStep[]
}

model Message {
  id             String   @id @default(cuid())
  role           String   @default("user") // user | assistant | system
  content        String
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  cost           Float    @default(0)
  sqlCode        String   @default("")
  agentName      String   @default("") // plan-agent | exec-agent | system
  reasoningSteps String   @default("[]") // JSON array of reasoning steps
  options        String   @default("[]") // JSON array of clarification options
  tablesJson     String   @default("{}") // Generated table data
  createdAt      DateTime @default(now())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AgentStep {
  id             String   @id @default(cuid())
  conversationId String
  agentName      String   // plan-agent | exec-agent | validation-agent
  stepType       String   // intent | domain_detection | entity_extraction | relationship_mapping | constraint_planning | data_strategy | validation | execution | reflection
  stepOrder      Int      @default(0)
  input          String   @default("")
  output         String   @default("")
  status         String   @default("pending") // pending | running | completed | failed
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Dataset {
  id          String   @id @default(cuid())
  name        String
  version     Int      @default(1)
  format      String   @default("json")
  rowCount    Int      @default(0)
  dataJson    String   @default("[]")
  schemaJson  String   @default("{}")
  seed        Int      @default(0)
  databaseId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  database    Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
}

model SchemaVersion {
  id          String   @id @default(cuid())
  version     Int      @default(1)
  schemaJson  String   @default("{}")
  description String   @default("")
  databaseId  String
  createdAt   DateTime @default(now())
  database    Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
}

model FileUpload {
  id          String   @id @default(cuid())
  filename    String
  mimeType    String
  size        Int      @default(0)
  content     String   @default("") // parsed text content
  fileType    String   @default("unknown") // sql | csv | json | pdf | excel | api-spec | image
  extractedSchema String @default("{}") // extracted schema info
  databaseId  String?
  createdAt   DateTime @default(now())
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String
  keyHash     String
  keyPrefix   String
  workspaceId String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AgentRegistryEntry {
  id              String   @id @default(cuid())
  agentId         String   @unique // discovery-agent | schema-agent | data-agent | etc.
  name            String
  role            String
  phase           Int      @default(1) // 1=Discovery, 2=Schema, 3=Generation
  status          String   @default("available") // available | busy | offline | error
  skills          String   @default("[]") // JSON array of skill IDs
  maxConcurrency  Int      @default(2)
  tasksCompleted  Int      @default(0)
  tasksFailed     Int      @default(0)
  avgExecTimeMs   Int      @default(0)
  lastHeartbeat   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
