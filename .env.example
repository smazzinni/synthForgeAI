# ─── Database (PostgreSQL via Prisma) ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synthforge

# ─── Auth & app ───
# Built-in email/password auth (sessions stored in PostgreSQL).
# true = login required; false = single-user demo mode (no login).
# Unset: required in production, demo in development.
AUTH_REQUIRED=true
# Public URL of the app; used to build password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# SMTP server for password-reset emails, e.g. smtps://user:pass@smtp.example.com:465
# Unset: the reset link is only logged (and returned in development).
SMTP_URL=
# From address for outgoing mail, e.g. "SynthForge <no-reply@example.com>"
MAIL_FROM=
# Set to true ONLY for http-only staging (disables the Secure flag on the session cookie).
INSECURE_COOKIES=false

# ─── DeepSeek API Configuration ───
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model Configuration
# Valid models: deepseek-chat, deepseek-reasoner, deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=16000
DEEPSEEK_THINKING_ENABLED=true

# Feature Flags
ENABLE_LIVE_STREAMING=true
ENABLE_REASONING_MODE=true
STREAM_THINKING_CONTENT=true

# ─── Security (production) ───
# Encrypts saved external-DB passwords at rest (AES-256-GCM). Use a long random
# string, e.g. `openssl rand -base64 32`.
CONNECTION_ENCRYPTION_KEY=
# Verify TLS certificates of external databases (default false: many managed
# providers use certs outside Node's CA store).
DB_SSL_REJECT_UNAUTHORIZED=false
# Allow users to connect to private/internal network hosts in production
# (default false — blocks SSRF to metadata endpoints and internal services).
ALLOW_PRIVATE_DB_HOSTS=false
