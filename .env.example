# ─── Database (Prisma / SQLite for local development) ───
# On Vercel/production, set this to your PostgreSQL connection string.
DATABASE_URL=file:./db/custom.db

# ─── Supabase Configuration ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Public Supabase keys (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── App Configuration ───
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── DeepSeek API Configuration ───
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model Configuration
# Valid models: deepseek-chat, deepseek-reasoner, deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=16000
DEEPSEEK_THINKING_ENABLED=true

# Feature Flags
ENABLE_LIVE_STREAMING=true
ENABLE_REASONING_MODE=true
STREAM_THINKING_CONTENT=true
